# Copy to .env and fill in. Never commit the real .env file.

# --- Tradovate ---
# Demo/paper credentials first. Do not set TRADOVATE_ENV=live until dry-run
# has been verified across multiple full sessions (see README).
TRADOVATE_ENV=demo
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
# Either an application cid/sec pair (from Tradovate's API Access Tokens
# page), or an appId/appVersion identifying your app. Consult
# https://tradovate.com Application Settings > API Access.
TRADOVATE_CID=
TRADOVATE_SECRET=
TRADOVATE_APP_ID=orb-bot
TRADOVATE_APP_VERSION=0.1.0
TRADOVATE_DEVICE_ID=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric chat IDs allowed to control the bot.
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Settings web UI (python -m orb_bot.webui) ---
# Required to start the UI at all - it edits live risk/sizing/trading-time
# parameters, so it refuses to run without a password set.
ORB_WEBUI_USERNAME=admin
ORB_WEBUI_PASSWORD=

# --- Runtime ---
# dry_run (no orders sent) or live (real orders). Must be dry_run until
# explicitly promoted.
ORB_MODE=dry_run
ORB_CONFIG_PATH=config/config.yaml
ORB_STATE_DB_PATH=state.db
